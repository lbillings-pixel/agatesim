# The owner's specimen photos stay on this machine (they can carry GPS data in
# their metadata, and the repo will be public). Only openly licensed reference
# images go in references/images/.
specimens/

# Full-resolution reference photos, fetched by scripts/fetch_reference_images.py
references/images/full/

# Session handoff notes for coding agents: local only (personal details, session links)
HANDOFF.md
# Reference library photos, fetched by `agatesim library fetch` (ADR 0066)
references/library/
